<!DOCTYPE html>
<html lang="pt">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>PIB São Miguel - Links Oficiais</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --dark: #0d1b2e;
            --gold: #c9a84c;
            --white: #ffffff;
            --glass-bg: rgba(255, 255, 255, 0.05);
            --glass-border: rgba(201, 168, 76, 0.2);
        }

        /* Trava o vazamento horizontal na raiz da página */
        html,
        body {
            margin: 0;
            padding: 0;
            width: 100%;
            overflow-x: hidden;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background: radial-gradient(circle at top right, #1a304d 0%, var(--dark) 60%);
            /* FIX 1: Fixa o fundo para ele não rasgar ao fazer scroll */
            background-attachment: fixed;
            color: var(--white);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 40px 20px;
            box-sizing: border-box;
            position: relative;
        }

        /* FIX 2: Muda as luzes para 'fixed' para não gerarem rolagem fantasma no final da página */
        body::before,
        body::after {
            content: '';
            position: fixed;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: rgba(201, 168, 76, 0.1);
            filter: blur(80px);
            z-index: 0;
            pointer-events: none;
            /* Impede que atrapalhem o clique nos botões */
        }

        body::before {
            top: 10%;
            right: -150px;
        }

        body::after {
            bottom: 10%;
            left: -150px;
        }

        .profile-container,
        .links-container,
        .footer {
            position: relative;
            z-index: 1;
        }

        .profile-container {
            text-align: center;
            margin-bottom: 30px;
            max-width: 400px;
            width: 100%;
        }

        .logo-avatar {
            width: 96px;
            height: 96px;
            border-radius: 50%;
            background: var(--glass-bg);
            padding: 8px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
            object-fit: contain;
            border: 3px solid var(--gold);
            margin-bottom: 16px;
        }

        h1 {
            font-size: 20px;
            font-weight: 800;
            color: var(--gold);
            margin: 0 0 4px 0;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .tagline {
            font-size: 13px;
            color: rgba(255, 255, 255, 0.7);
            margin: 0;
            font-weight: 500;
        }

        .links-container {
            max-width: 500px;
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .btn-link {
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            color: var(--white);
            padding: 18px 54px;
            text-align: center;
            line-height: 1.4;
            border-radius: 16px;
            text-decoration: none;
            font-weight: 700;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
            box-sizing: border-box;
        }

        .btn-link.featured {
            background: var(--white);
            color: var(--dark);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
        }

        .btn-link.featured:hover {
            background: var(--gold);
            color: var(--dark);
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(201, 168, 76, 0.4);
        }

        .btn-link.glass {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);

            /* FIX 3: Corta o vazamento do efeito de vidro nas bordas (Bug do iOS/Safari) */
            overflow: hidden;
            transform: translateZ(0);
            -webkit-mask-image: -webkit-radial-gradient(white, black);
        }

        .btn-link.glass:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: var(--gold);
            transform: translateY(-3px) scale(1.01);
            box-shadow: 0 10px 30px rgba(201, 168, 76, 0.2);
        }

        .btn-link.glass.disabled {
            opacity: 0.3;
            pointer-events: none;
            border-color: rgba(255, 255, 255, 0.05);
        }

        .icon-left {
            position: absolute;
            left: 24px;
            display: flex;
            align-items: center;
        }

        .btn-link svg {
            width: 20px;
            height: 20px;
            fill: currentColor;
        }

        .btn-link.featured .icon-left svg {
            fill: var(--dark);
        }

        .btn-link.featured:hover .icon-left svg {
            fill: var(--dark);
        }

        .footer {
            margin-top: auto;
            padding-top: 40px;
            font-size: 11px;
            color: rgba(255, 255, 255, 0.3);
            text-align: center;
            font-weight: 500;
        }

        /* ========================================= */
        /* RESPONSIVIDADE PARA SMARTPHONES PEQUENOS */
        /* ========================================= */
        @media (max-width: 480px) {
            body {
                padding: 30px 15px;
            }

            .logo-avatar {
                width: 80px;
                height: 80px;
            }

            h1 {
                font-size: 18px;
            }

            .btn-link {
                padding: 16px 45px;
                font-size: 12.5px;
            }

            .icon-left {
                left: 16px;
            }

            .btn-link svg {
                width: 18px;
                height: 18px;
            }

            .badge-disabled {
                display: none;
            }
        }
    </style>
</head>

<body>

