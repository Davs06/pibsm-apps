<!DOCTYPE html>
<html lang="pt">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>PIB São Miguel - Links Oficiais</title>

    <!-- Fonte Oficial -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Tailwind CSS Compilado -->
    <link rel="stylesheet" href="/css/output.css">

    <!-- Lucide Icons (CDN) -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>

<body class="py-10 px-5 sm:py-12 flex flex-col items-center">

    <!-- Perfil -->
    <div class="text-center mb-8 max-w-[400px] w-full relative z-10 flex flex-col items-center">
        <img src="/assets/img/logo.png" alt="Logotipo da Igreja"
            class="w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-white/5 p-2 shadow-lg object-contain border-[3px] border-gold mb-4">
        <h1 class="text-[18px] sm:text-[20px] font-extrabold text-gold mb-1 tracking-[1px] uppercase">
            PIB São Miguel
        </h1>
        <p class="text-[13px] text-white/70 font-medium m-0">
            Uma família que ama, cuida e anuncia
        </p>
    </div>

    <!-- Lista de Links -->
    <div class="max-w-[500px] w-full flex flex-col gap-4 relative z-10">

        <!-- Destaques -->

        <a href="https://pibsaomiguel.com.br"
            class="group flex items-center justify-center relative bg-white text-dark py-4 sm:py-4 px-14 text-center rounded-2xl font-bold text-[13px] sm:text-[14px] uppercase tracking-[0.5px] shadow-md hover:bg-gold hover:-translate-y-1 hover:shadow-lg hover:shadow-gold/40 transition-all duration-300">
            <span class="absolute left-5 sm:left-6 flex items-center text-dark">
                <i data-lucide="globe" class="w-5 h-5"></i>
            </span>
            Site Oficial
        </a>
        <a href="https://boletim.pibsaomiguel.com.br/mobile"
            class="group flex items-center justify-center relative bg-white text-dark py-4 sm:py-4 px-14 text-center rounded-2xl font-bold text-[13px] sm:text-[14px] uppercase tracking-[0.5px] shadow-md hover:bg-gold hover:-translate-y-1 hover:shadow-lg hover:shadow-gold/40 transition-all duration-300">
            <span class="absolute left-5 sm:left-6 flex items-center text-dark">
                <i data-lucide="book-open" class="w-5 h-5"></i>
            </span>
            Boletim Semanal
        </a>

        <a href="https://calendario.pibsaomiguel.com.br"
            class="group flex items-center justify-center relative bg-white text-dark py-4 sm:py-4 px-14 text-center rounded-2xl font-bold text-[13px] sm:text-[14px] uppercase tracking-[0.5px] shadow-md hover:bg-gold hover:-translate-y-1 hover:shadow-lg hover:shadow-gold/40 transition-all duration-300">
            <span class="absolute left-5 sm:left-6 flex items-center text-dark">
                <i data-lucide="calendar" class="w-5 h-5"></i>
            </span>
            Calendário de Atividades
        </a>

        <!-- Links Glassmorphism -->
        <a href="https://www.instagram.com/pibsaomiguel" target="_blank"
            class="group flex items-center justify-center relative bg-white/5 border border-gold/20 backdrop-blur-md text-white py-4 sm:py-4 px-14 text-center rounded-2xl font-bold text-[13px] sm:text-[14px] uppercase tracking-[0.5px] shadow-sm hover:bg-white/10 hover:border-gold hover:-translate-y-1 hover:shadow-lg hover:shadow-gold/20 hover:scale-[1.01] overflow-hidden transition-all duration-300">
            <span class="absolute left-5 sm:left-6 flex items-center text-white">
                <i data-lucide="instagram" class="w-5 h-5"></i>
            </span>
            Instagram Principal
        </a>

        <a href="https://www.instagram.com/projetopromusica" target="_blank"
            class="group flex items-center justify-center relative bg-white/5 border border-gold/20 backdrop-blur-md text-white py-4 sm:py-4 px-14 text-center rounded-2xl font-bold text-[13px] sm:text-[14px] uppercase tracking-[0.5px] shadow-sm hover:bg-white/10 hover:border-gold hover:-translate-y-1 hover:shadow-lg hover:shadow-gold/20 hover:scale-[1.01] overflow-hidden transition-all duration-300">
            <span class="absolute left-5 sm:left-6 flex items-center text-white">
                <i data-lucide="music" class="w-5 h-5"></i>
            </span>
            Projeto Pró-Música
        </a>

        <a href="https://www.instagram.com/propositodoingles" target="_blank"
            class="group flex items-center justify-center relative bg-white/5 border border-gold/20 backdrop-blur-md text-white py-4 sm:py-4 px-14 text-center rounded-2xl font-bold text-[13px] sm:text-[14px] uppercase tracking-[0.5px] shadow-sm hover:bg-white/10 hover:border-gold hover:-translate-y-1 hover:shadow-lg hover:shadow-gold/20 hover:scale-[1.01] overflow-hidden transition-all duration-300">
            <span class="absolute left-5 sm:left-6 flex items-center text-white">
                <i data-lucide="book-type" class="w-5 h-5"></i>
            </span>
            Propósito do Inglês
        </a>

        <a href="https://www.facebook.com/pibsaomiguel" target="_blank"
            class="group flex items-center justify-center relative bg-white/5 border border-gold/20 backdrop-blur-md text-white py-4 sm:py-4 px-14 text-center rounded-2xl font-bold text-[13px] sm:text-[14px] uppercase tracking-[0.5px] shadow-sm hover:bg-white/10 hover:border-gold hover:-translate-y-1 hover:shadow-lg hover:shadow-gold/20 hover:scale-[1.01] overflow-hidden transition-all duration-300">
            <span class="absolute left-5 sm:left-6 flex items-center text-white">
                <i data-lucide="facebook" class="w-5 h-5"></i>
            </span>
            Facebook
        </a>

        <a href="https://www.youtube.com/@pibsaomiguel" target="_blank"
            class="group flex items-center justify-center relative bg-white/5 border border-gold/20 backdrop-blur-md text-white py-4 sm:py-4 px-14 text-center rounded-2xl font-bold text-[13px] sm:text-[14px] uppercase tracking-[0.5px] shadow-sm hover:bg-white/10 hover:border-gold hover:-translate-y-1 hover:shadow-lg hover:shadow-gold/20 hover:scale-[1.01] overflow-hidden transition-all duration-300">
            <span class="absolute left-5 sm:left-6 flex items-center text-white">
                <i data-lucide="youtube" class="w-5 h-5"></i>
            </span>
            YouTube
        </a>
    </div>

    <!-- Footer -->
    <div class="mt-auto pt-10 text-[11px] text-white/30 text-center font-medium relative z-10">
        &copy; 2026 Primeira Igreja Batista em São Miguel Paulista | By: Tech Rocket
    </div>

    <!-- Inicializar Ícones Lucide -->
    <script>
        lucide.createIcons();
    </script>
</body>

</html>