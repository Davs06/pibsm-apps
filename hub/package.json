{
  "name": "pib-hub",
  "version": "1.0.0",
  "description": "Portal Central da PIB São Miguel",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "tailwind:build": "npx tailwindcss -i ./public/css/input.css -o ./public/css/output.css",
    "tailwind:watch": "npx tailwindcss -i ./public/css/input.css -o ./public/css/output.css --watch",
    "dev": "concurrently \"npm run tailwind:watch\" \"nodemon server.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "ejs": "^3.1.9",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "autoprefixer": "^10.5.5",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "nodemon": "^3.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19"
  }
}
