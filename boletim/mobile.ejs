<!DOCTYPE html>
<html lang="pt">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PIB São Miguel - Boletim Digital</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: 'Montserrat', sans-serif;
            background: #f5f0e8;
            color: #0d1b2e;
        }

        .header {
            background: #0d1b2e;
            padding: 30px 20px;
            text-align: center;
            color: white;
            border-bottom: 5px solid #c9a84c;
        }

        .header h1 {
            margin: 0;
            color: #c9a84c;
            font-size: 28px;
            font-weight: 800;
        }

        .header p {
            margin: 5px 0 15px 0;
            font-size: 14px;
            opacity: 0.9;
        }

        .date {
            background: #c9a84c;
            color: #0d1b2e;
            padding: 6px 20px;
            border-radius: 20px;
            font-weight: bold;
            font-size: 14px;
            display: inline-block;
        }

        .content {
            padding: 20px;
            max-width: 600px;
            margin: 0 auto;
        }

        .section-title {
            background: #0d1b2e;
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: bold;
            margin-top: 25px;
            text-transform: uppercase;
            font-size: 13px;
            display: inline-block;
        }

        .section-title.gold {
            background: #c9a84c;
            color: #0d1b2e;
        }

        .card {
            background: white;
            padding: 20px;
            border-radius: 12px;
            margin-top: 15px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
        }

        .text-block {
            line-height: 1.6;
            font-size: 14px;
            color: #444;
        }

        .list-item {
            padding: 6px 0;
            border-bottom: 1px solid #f0f0f0;
            font-size: 13px;
            color: #444;
        }

        .list-item:last-child {
            border-bottom: none;
        }

        .event {
            margin-bottom: 15px;
        }

        .event-day {
            font-weight: 800;
            color: #c9a84c;
            font-size: 16px;
            margin-bottom: 5px;
        }

        .event-line {
            background: #f9f9f9;
            padding: 8px 12px;
            border-radius: 6px;
            margin-bottom: 5px;
            font-size: 13px;
            font-weight: 600;
        }

        .aniv {
            display: flex;
            justify-content: space-between;
            font-size: 14px;
            padding: 8px 0;
            border-bottom: 1px solid #eee;
        }

        .aniv-date {
            font-weight: 800;
            color: #c9a84c;
        }

        .footer {
            text-align: center;
            padding: 30px;
            font-size: 12px;
            color: #888;
        }

        .sub-title {
            font-size: 14px;
            color: #0d1b2e;
            font-weight: 800;
            text-transform: uppercase;
            margin: 20px 0 10px 0;
            border-top: 1px dashed #ccc;
            padding-top: 15px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* Botão Editar (Flutuante no canto superior direito) */
        .btn-edit {
            display: none;
            /* Escondido por padrão (telemóveis) */
            position: fixed;
            top: 20px;
            right: 20px;
            background: #c9a84c;
            color: #0d1b2e;
            padding: 10px 20px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 800;
            font-size: 13px;
            text-transform: uppercase;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
            transition: transform 0.2s, background 0.2s;
            z-index: 1000;
        }

        .btn-edit:hover {
            background: #b5953b;
            transform: translateY(-2px);
        }

        /* Media Query: Só mostra o botão se o ecrã tiver 768px ou mais (Tablets/PCs) */
        @media (min-width: 768px) {
            .btn-edit {
                display: inline-block;
            }
        }
    </style>
</head>

<body>

    <a href="/admin" class="btn-edit">✏️ Editar Boletim</a>

    <div class="header">
        <h1>PIB SÃO MIGUEL</h1>
        <p>Boletim Semanal Digital</p>
        <div class="date">
            <%= data.data_boletim || '' %>
        </div>
    </div>

    <div class="content">
        <div class="section-title">📖 Palavra do Pastor</div>
        <div class="card text-block">
            <%- (data.palavra_pastor || '' ).replace(/\n/g, '<br>' ) %>
        </div>

        <div class="section-title">📅 Atividades da Semana</div>
        <div class="card">
            <% (data.atividades || '' ).split('\n').forEach(function(linha) { if(linha.trim()) { let
                partes=linha.split('|'); %>
                <div class="event">
                    <div class="event-day">
                        <%= partes[0] || '' %> - <%= partes[1] || '' %>
                    </div>
                    <% let eventos=partes[2] ? partes[2].split(',') : []; eventos.forEach(function(ev) { %>
                        <div class="event-line">
                            <%= ev.trim() %>
                        </div>
                        <% }); %>
                </div>
                <% } }); %>
        </div>

        <div class="section-title">🙏 Liturgia e Celebração</div>

        <div class="card">
            <h3 style="margin-top: 0; color: #c9a84c; font-size: 18px;">☀️ Culto Matutino - 09h00</h3>

            <% (data.culto_matutino || '' ).split('\n').filter(l=> l.trim()).forEach(function(item, index) { %>
                <div class="list-item">
                    <span style="color: #c9a84c; font-weight: 800;">
                        <%= (index+1).toString().padStart(2, '0' ) %>.
                    </span>
                    <%= item %>
                </div>
                <% }); %>

                    <div class="sub-title">👥 Equipe Responsável</div>
                    <% (data.equipe_matutino || '' ).split('\n').filter(l=> l.trim()).forEach(function(linha) {
                        var idx = linha.indexOf(':');
                        var hasColon = idx !== -1;
                        var title = hasColon ? linha.substring(0, idx) : linha;
                        var val = hasColon ? linha.substring(idx + 1) : '';
                        %>
                        <div style="font-size: 13px; margin-bottom: 5px;">
                            <% if(hasColon) { %>
                                <strong style="color: #0d1b2e;">
                                    <%= title %>:
                                </strong>
                                <%= val %>
                                    <% } else { %>
                                        <%= linha %>
                                            <% } %>
                        </div>
                        <% }); %>
        </div>

        <div class="card">
            <h3 style="margin-top: 0; color: #c9a84c; font-size: 18px;">🌙 Culto Vespertino - 18h00</h3>

            <% (data.culto_vespertino || '' ).split('\n').filter(l=> l.trim()).forEach(function(item, index) { %>
                <div class="list-item">
                    <span style="color: #c9a84c; font-weight: 800;">
                        <%= (index+1).toString().padStart(2, '0' ) %>.
                    </span>
                    <%= item %>
                </div>
                <% }); %>

                    <div class="sub-title">👥 Equipe Responsável</div>
                    <% (data.equipe_vespertino || '' ).split('\n').filter(l=> l.trim()).forEach(function(linha) {
                        var idx = linha.indexOf(':');
                        var hasColon = idx !== -1;
                        var title = hasColon ? linha.substring(0, idx) : linha;
                        var val = hasColon ? linha.substring(idx + 1) : '';
                        %>
                        <div style="font-size: 13px; margin-bottom: 5px;">
                            <% if(hasColon) { %>
                                <strong style="color: #0d1b2e;">
                                    <%= title %>:
                                </strong>
                                <%= val %>
                                    <% } else { %>
                                        <%= linha %>
                                            <% } %>
                        </div>
                        <% }); %>
        </div>

        <div class="section-title gold">🙏 Motivos de Gratidão</div>
        <div class="card">
            <% (data.gratidao || '' ).split('\n').forEach(function(linha) { if(linha.trim()){ %>
                <div class="list-item">✨ <%= linha %>
                </div>
                <% } }); %>
        </div>

        <div class="section-title">🙌 Pedidos de Oração</div>
        <div class="card">
            <% (data.oracao || '' ).split('\n').forEach(function(linha) { if(linha.trim()){ %>
                <div class="list-item">🤲 <%= linha %>
                </div>
                <% } }); %>
        </div>

        <div class="section-title gold">🎂 Aniversariantes</div>
        <div class="card">
            <% (data.aniversariantes || '' ).split('\n').forEach(function(linha) { if(linha.trim()) { let
                partes=linha.split('|'); %>
                <div class="aniv">
                    <span class="aniv-name">
                        <%= partes[1] || '' %>
                    </span>
                    <span class="aniv-date">
                        <%= partes[0] || '' %>
                    </span>
                </div>
                <% } }); %>
        </div>

    </div>

    <div class="footer">
        Igreja Batista em São Miguel Paulista<br>
        Rua Arlindo Colaço, 85<br><br>
        @pibsaomiguel
    </div>

</body>

</html>