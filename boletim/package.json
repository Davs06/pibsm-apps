{
  "name": "boletim-app",
  "version": "1.0.0",
  "description": "Gerador de Boletim Semanal",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "tailwind:build": "npx tailwindcss -i ./public/assets/css/input.css -o ./public/assets/css/output.css",
    "tailwind:watch": "npx tailwindcss -i ./public/assets/css/input.css -o ./public/assets/css/output.css --watch",
    "dev": "concurrently \"npm run tailwind:watch\" \"nodemon server.js\"",
    "build": "npm run tailwind:build",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.105.4",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.0.1",
    "postcss": "^8.4.38",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17"
  }
}
