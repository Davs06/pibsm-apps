<!DOCTYPE html>
<html lang="pt" class="antialiased">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - PIB São Miguel</title>
    <!-- Tailwind CSS -->
    <link rel="stylesheet" href="/assets/css/output.css">
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>

<body class="bg-cream dark:bg-slate-900 text-dark dark:text-slate-100 font-sans transition-colors duration-300 py-10 px-4">

    <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 bg-white dark:bg-slate-800 p-6 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700">
            <div>
                <h1 class="text-2xl font-black text-dark dark:text-white uppercase tracking-tight flex items-center gap-2">
                    <i data-lucide="settings" class="w-6 h-6 text-gold"></i>
                    Editar Boletim Semanal
                </h1>
                <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Preencha os dados para gerar a versão atualizada.</p>
            </div>
            <a href="/logout" class="inline-flex items-center gap-2 bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400 hover:bg-red-200 dark:hover:bg-red-900/50 px-4 py-2 rounded-lg font-bold text-sm transition-colors border border-red-200 dark:border-red-800">
                <i data-lucide="log-out" class="w-4 h-4"></i>
                Sair
            </a>
        </div>

        <main class="w-full max-w-4xl mx-auto p-4 md:p-6 lg:p-8 relative z-10">
            <form action="/admin" method="POST" class="bg-white/80 dark:bg-slate-800/80 backdrop-blur-xl border border-white/50 dark:border-slate-700/50 p-6 md:p-10 rounded-2xl shadow-2xl space-y-8 mb-8">
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Data do Boletim -->
                <div class="space-y-2">
                    <label class="block text-sm font-bold text-slate-700 dark:text-slate-300">Data do Boletim</label>
                    <input type="text" name="data_boletim" value="<%= data.data_boletim || '' %>" 
                        class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-900/50 border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-gold/50 focus:border-gold outline-none transition-all text-slate-900 dark:text-white">
                </div>

                <!-- Tema da Semana -->
                <div class="space-y-2 md:col-span-2">
                    <label class="block text-sm font-bold text-slate-700 dark:text-slate-300">Tema da Semana</label>
                    <input type="text" name="tema_semana" value="<%= data.tema_semana || '' %>" 
                        class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-900/50 border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-gold/50 focus:border-gold outline-none transition-all text-slate-900 dark:text-white">
                </div>

                <!-- Vídeo de Avisos (YouTube ou URL) -->
                <div class="space-y-2 md:col-span-2">
                    <div class="flex flex-wrap items-center justify-between gap-1">
                        <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 flex items-center gap-2">
                            <i data-lucide="video" class="w-4 h-4 text-gold"></i>
                            <span>Vídeo de Avisos (Link do YouTube ou Direto)</span>
                        </label>
                        <span class="text-xs text-gold font-bold">Sem limite de tamanho (YouTube Não Listado)</span>
                    </div>
                    <input type="text" name="video_avisos" value="<%= data.video_avisos || '' %>" 
                        placeholder="Ex: https://youtu.be/F1yhu3bpnVE ou https://www.youtube.com/watch?v=..."
                        class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-900/50 border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-gold/50 focus:border-gold outline-none transition-all text-slate-900 dark:text-white">
                    <p class="text-xs text-slate-500 dark:text-slate-400">
                        Cole aqui o link do vídeo não listado do YouTube para contornar o limite de 50MB do Supabase Storage.
                    </p>
                </div>
            </div>

            <!-- Palavra do Pastor -->
            <div class="space-y-2">
                <label class="block text-sm font-bold text-slate-700 dark:text-slate-300">Palavra do Pastor</label>
                <textarea name="palavra_pastor" rows="6" 
                    class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-900/50 border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-gold/50 focus:border-gold outline-none transition-all text-slate-900 dark:text-white leading-relaxed"><%= data.palavra_pastor || '' %></textarea>
            </div>

            <!-- Atividades -->
            <div class="space-y-2">
                <label class="block text-sm font-bold text-slate-700 dark:text-slate-300">Atividades (DIA | SEMANA | EVENTOS)</label>
                <span class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">Ex: 26|DOM|09h00 Culto Matutino, 18h00 Culto Vespertino</span>
                <textarea name="atividades" rows="6" 
                    class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-900/50 border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-gold/50 focus:border-gold outline-none transition-all text-slate-900 dark:text-white"><%= data.atividades || '' %></textarea>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Motivos de Gratidão -->
                <div class="space-y-2">
                    <label class="block text-sm font-bold text-slate-700 dark:text-slate-300">Motivos de Gratidão (Um por linha)</label>
                    <textarea name="gratidao" rows="6" 
                        class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-900/50 border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-gold/50 focus:border-gold outline-none transition-all text-slate-900 dark:text-white"><%= data.gratidao || '' %></textarea>
                </div>
                <!-- Pedidos de Oração -->
                <div class="space-y-2">
                    <label class="block text-sm font-bold text-slate-700 dark:text-slate-300">Pedidos de Oração (Um por linha)</label>
                    <textarea name="oracao" rows="6" 
                        class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-900/50 border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-gold/50 focus:border-gold outline-none transition-all text-slate-900 dark:text-white"><%= data.oracao || '' %></textarea>
                </div>
            </div>

            <!-- Aniversariantes -->
            <div class="space-y-2">
                <label class="block text-sm font-bold text-slate-700 dark:text-slate-300">Aniversariantes (DATA | NOME)</label>
                <span class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">Ex: 20/04|Darlene G. Miranda</span>
                <textarea name="aniversariantes" rows="5" 
                    class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-900/50 border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-gold/50 focus:border-gold outline-none transition-all text-slate-900 dark:text-white"><%= data.aniversariantes || '' %></textarea>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Ordem do Culto Matutino -->
                <div class="space-y-2">
                    <label class="block text-sm font-bold text-slate-700 dark:text-slate-300">Ordem do Culto Matutino (Um por linha)</label>
                    <textarea name="culto_matutino" rows="8" 
                        class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-900/50 border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-gold/50 focus:border-gold outline-none transition-all text-slate-900 dark:text-white"><%= data.culto_matutino || '' %></textarea>
                </div>
                <!-- Ordem do Culto Vespertino -->
                <div class="space-y-2">
                    <label class="block text-sm font-bold text-slate-700 dark:text-slate-300">Ordem do Culto Vespertino (Um por linha)</label>
                    <textarea name="culto_vespertino" rows="8" 
                        class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-900/50 border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-gold/50 focus:border-gold outline-none transition-all text-slate-900 dark:text-white"><%= data.culto_vespertino || '' %></textarea>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Equipe Matutino -->
                <div class="space-y-2">
                    <label class="block text-sm font-bold text-slate-700 dark:text-slate-300">Equipa do Culto (Matutino)</label>
                    <textarea name="equipe_matutino" rows="6" 
                        class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-900/50 border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-gold/50 focus:border-gold outline-none transition-all text-slate-900 dark:text-white"><%= data.equipe_matutino || '' %></textarea>
                </div>
                <!-- Equipe Vespertino -->
                <div class="space-y-2">
                    <label class="block text-sm font-bold text-slate-700 dark:text-slate-300">Equipa do Culto (Vespertino)</label>
                    <textarea name="equipe_vespertino" rows="6" 
                        class="w-full px-4 py-3 bg-slate-50 dark:bg-slate-900/50 border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-gold/50 focus:border-gold outline-none transition-all text-slate-900 dark:text-white"><%= data.equipe_vespertino || '' %></textarea>
                </div>
            </div>

            <button type="submit" 
                class="w-full mt-4 flex items-center justify-center gap-2 bg-dark hover:bg-gold text-white hover:text-dark py-4 rounded-xl font-extrabold uppercase tracking-widest transition-all shadow-lg hover:shadow-gold/30">
                <i data-lucide="save" class="w-5 h-5"></i>
                <span>Salvar e Gerar Boletim</span>
            </button>
        </form>

        <!-- Formulário Primário de Vídeo: Automação YouTube via n8n -->
        <div class="bg-white/80 dark:bg-slate-800/80 backdrop-blur-xl border border-red-500/30 dark:border-red-500/20 p-6 md:p-8 rounded-2xl shadow-xl space-y-6 mb-8">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div>
                    <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2 mb-1">
                        <i data-lucide="youtube" class="w-6 h-6 text-red-500"></i>
                        <span>Upload Automático para o YouTube (Recomendado)</span>
                    </h2>
                    <p class="text-sm text-slate-600 dark:text-slate-400">
                        Envie vídeos de até <strong>500MB</strong>. A automação no <strong>n8n</strong> publicará no YouTube como <strong>Não Listado</strong> e atualizará o boletim automaticamente.
                    </p>
                </div>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-red-50 dark:bg-red-950/40 text-red-600 dark:text-red-400 text-xs font-bold rounded-full border border-red-200 dark:border-red-900 w-fit">
                    <i data-lucide="zap" class="w-3.5 h-3.5"></i>
                    Automação n8n
                </span>
            </div>

            <form id="youtubeUploadForm" class="space-y-4">
                <div class="space-y-2">
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
                        Arquivo de Vídeo (MP4, WebM, MOV)
                    </label>
                    <input type="file" id="ytVideoFile" accept="video/mp4,video/webm,video/quicktime" required
                        class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-900/50 border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-red-500/50 focus:border-red-500 outline-none transition-all text-slate-900 dark:text-white file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-red-600 file:text-white hover:file:bg-red-700">
                </div>

                <!-- Barra de Progresso e Status -->
                <div id="ytProgressContainer" class="hidden space-y-2 pt-2">
                    <div class="flex items-center justify-between text-xs font-bold text-slate-700 dark:text-slate-300">
                        <span id="ytStatusText" class="flex items-center gap-2">
                            <i data-lucide="loader-2" class="w-4 h-4 animate-spin text-red-500"></i>
                            <span>Enviando arquivo ao servidor...</span>
                        </span>
                        <span id="ytProgressPercent" class="text-red-500 font-extrabold">0%</span>
                    </div>
                    <div class="w-full h-3 bg-slate-200 dark:bg-slate-700 rounded-full overflow-hidden">
                        <div id="ytProgressBar" class="h-full bg-gradient-to-r from-red-600 to-red-400 rounded-full transition-all duration-300" style="width: 0%"></div>
                    </div>
                </div>

                <!-- Feedback Message -->
                <div id="ytAlert" class="hidden p-4 rounded-xl text-sm font-medium"></div>

                <button type="submit" id="ytSubmitBtn"
                    class="w-full md:w-auto bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-6 rounded-lg transition-all shadow-md hover:shadow-red-500/20 flex items-center justify-center gap-2">
                    <i data-lucide="upload" class="w-5 h-5"></i>
                    <span>Subir Vídeo para o YouTube</span>
                </button>
            </form>
        </div>

        <!-- Formulário Secundário (Upload de Vídeo Legado Supabase) -->
        <form id="videoForm" action="/admin/upload-video" method="POST" enctype="multipart/form-data" class="bg-white/80 dark:bg-slate-800/80 backdrop-blur-xl border border-gold/30 dark:border-gold/30 p-6 md:p-8 rounded-2xl shadow-xl space-y-6">
            <div>
                <h2 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2 mb-2">
                    <i data-lucide="upload-cloud" class="w-6 h-6 text-gold"></i>
                    Upload Direto para Supabase (Alternativa - Máx. 50MB)
                </h2>
                <p class="text-sm text-slate-600 dark:text-slate-400">
                    O Supabase Storage possui um limite máximo de <strong>50MB</strong> por arquivo. Se o vídeo for maior, utilize o card de upload do YouTube acima.
                </p>
            </div>

            <div class="space-y-2">
                <input type="file" id="videoInput" name="video_file" accept="video/mp4,video/webm" required
                    class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-900/50 border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-gold/50 focus:border-gold outline-none transition-all text-slate-900 dark:text-white file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-gold file:text-dark hover:file:bg-gold/80">
            </div>

            <button type="submit" class="w-full md:w-auto bg-dark hover:bg-slate-800 text-white font-bold py-3 px-6 rounded-lg transition-colors flex items-center justify-center gap-2">
                <i data-lucide="upload-cloud" class="w-5 h-5 text-gold"></i>
                <span>Enviar para Supabase</span>
            </button>
        </form>
    </div>

    <script>
        lucide.createIcons();

        // Automação YouTube com Barra de Progresso
        const ytForm = document.getElementById('youtubeUploadForm');
        const ytFileInput = document.getElementById('ytVideoFile');
        const ytSubmitBtn = document.getElementById('ytSubmitBtn');
        const ytProgressContainer = document.getElementById('ytProgressContainer');
        const ytProgressBar = document.getElementById('ytProgressBar');
        const ytProgressPercent = document.getElementById('ytProgressPercent');
        const ytStatusText = document.getElementById('ytStatusText');
        const ytAlert = document.getElementById('ytAlert');
        const videoAvisosInput = document.querySelector('input[name="video_avisos"]');

        if (ytForm) {
            ytForm.addEventListener('submit', function(e) {
                e.preventDefault();
                const file = ytFileInput.files[0];
                if (!file) {
                    alert('Por favor, selecione um arquivo de vídeo.');
                    return;
                }

                if (file.size > 500 * 1024 * 1024) {
                    alert('ERRO: O arquivo selecionado tem mais de 500MB.');
                    return;
                }

                // Usa o nome do arquivo selecionado no computador (sem a extensão) como título do vídeo
                const videoTitle = file.name.replace(/\.[^/.]+$/, '');

                const formData = new FormData();
                formData.append('video_file', file);
                formData.append('title', videoTitle);

                ytSubmitBtn.disabled = true;
                ytSubmitBtn.classList.add('opacity-50', 'cursor-not-allowed');
                ytProgressContainer.classList.remove('hidden');
                ytAlert.classList.add('hidden');
                ytProgressBar.style.width = '0%';
                ytProgressPercent.textContent = '0%';
                ytStatusText.innerHTML = '<i data-lucide="loader-2" class="w-4 h-4 animate-spin text-red-500 inline mr-2"></i><span>Enviando arquivo ao servidor...</span>';
                lucide.createIcons();

                const xhr = new XMLHttpRequest();
                xhr.open('POST', '/admin/upload-video-youtube');

                xhr.upload.onprogress = function(event) {
                    if (event.lengthComputable) {
                        const percent = Math.round((event.loaded / event.total) * 100);
                        ytProgressBar.style.width = percent + '%';
                        ytProgressPercent.textContent = percent + '%';
                        if (percent >= 100) {
                            ytStatusText.innerHTML = '<i data-lucide="loader-2" class="w-4 h-4 animate-spin text-red-500 inline mr-2"></i><span>Processando no n8n e publicando no YouTube... Aguarde.</span>';
                            lucide.createIcons();
                        }
                    }
                };

                xhr.onload = function() {
                    ytSubmitBtn.disabled = false;
                    ytSubmitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                    ytProgressContainer.classList.add('hidden');
                    ytStatusText.innerHTML = '';

                    try {
                        const res = JSON.parse(xhr.responseText);
                        if (xhr.status === 200 && res.success) {
                            ytAlert.className = 'p-4 rounded-xl text-sm font-medium bg-green-100 dark:bg-green-950/50 text-green-800 dark:text-green-300 border border-green-200 dark:border-green-900 flex flex-col sm:flex-row sm:items-center justify-between gap-3';
                            if (res.videoUrl) {
                                ytAlert.innerHTML = `
                                    <div>
                                        <strong class="block mb-1">✓ Vídeo publicado com sucesso no YouTube!</strong>
                                        <span class="text-xs text-green-700 dark:text-green-400">O link foi configurado no campo de vídeo do boletim:</span>
                                        <a href="${res.videoUrl}" target="_blank" class="block font-bold underline mt-0.5">${res.videoUrl}</a>
                                    </div>
                                `;
                                if (videoAvisosInput) {
                                    videoAvisosInput.value = res.videoUrl;
                                }
                            } else {
                                ytAlert.innerHTML = `
                                    <div>
                                        <strong class="block mb-1">✓ Vídeo recebido pelo n8n com sucesso!</strong>
                                        <span class="text-xs text-green-700 dark:text-green-400">${res.message || 'O processamento e upload no YouTube foram iniciados na sua automação.'}</span>
                                    </div>
                                `;
                            }
                            ytAlert.classList.remove('hidden');
                            ytFileInput.value = '';
                        } else {
                            ytAlert.className = 'p-4 rounded-xl text-sm font-medium bg-red-100 dark:bg-red-950/50 text-red-800 dark:text-red-300 border border-red-200 dark:border-red-900';
                            ytAlert.textContent = 'ERRO: ' + (res.error || 'Falha ao processar vídeo.');
                            ytAlert.classList.remove('hidden');
                        }
                    } catch (parseError) {
                        ytAlert.className = 'p-4 rounded-xl text-sm font-medium bg-red-100 dark:bg-red-950/50 text-red-800 dark:text-red-300 border border-red-200 dark:border-red-900';
                        ytAlert.textContent = 'Erro inesperado na resposta do servidor.';
                        ytAlert.classList.remove('hidden');
                    }
                    lucide.createIcons();
                };

                xhr.onerror = function() {
                    ytSubmitBtn.disabled = false;
                    ytSubmitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                    ytProgressContainer.classList.add('hidden');
                    ytStatusText.innerHTML = '';
                    ytAlert.className = 'p-4 rounded-xl text-sm font-medium bg-red-100 dark:bg-red-950/50 text-red-800 dark:text-red-300 border border-red-200 dark:border-red-900';
                    ytAlert.textContent = 'Erro de conexão ao enviar o arquivo de vídeo.';
                    ytAlert.classList.remove('hidden');
                    lucide.createIcons();
                };

                xhr.send(formData);
            });
        }

        // Trava no frontend para limite de 50MB no formulário legado do Supabase
        const videoForm = document.getElementById('videoForm');
        const videoInput = document.getElementById('videoInput');

        if (videoForm && videoInput) {
            videoForm.addEventListener('submit', function(e) {
                const file = videoInput.files[0];
                if (file) {
                    const maxSize = 50 * 1024 * 1024; // 50MB
                    if (file.size > maxSize) {
                        e.preventDefault();
                        const fileSizeMB = (file.size / (1024 * 1024)).toFixed(2);
                        alert(`ERRO: O vídeo selecionado tem ${fileSizeMB}MB.\nO limite máximo para o Supabase é de 50MB.\nUtilize a automação do YouTube acima para vídeos maiores.`);
                    }
                }
            });
        }
    </script>
</body>

</html>