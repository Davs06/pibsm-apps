<!DOCTYPE html>
<html lang="pt" class="antialiased">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Boletim PIB</title>
    <!-- Tailwind CSS -->
    <link rel="stylesheet" href="/assets/css/output.css">
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="min-h-screen flex items-center justify-center bg-cream dark:bg-slate-900 transition-colors duration-300 p-4">

    <!-- Background Decoration (Optional subtle glow) -->
    <div class="fixed top-0 left-0 w-full h-full overflow-hidden -z-10 pointer-events-none">
        <div class="absolute -top-32 -right-32 w-96 h-96 bg-gold/20 dark:bg-gold/10 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-32 -left-32 w-96 h-96 bg-dark/10 dark:bg-blue-900/20 rounded-full blur-3xl"></div>
    </div>

    <!-- Login Card -->
    <div class="w-full max-w-sm bg-white/70 dark:bg-slate-800/60 backdrop-blur-xl border border-white/40 dark:border-slate-700/50 p-8 rounded-2xl shadow-2xl">
        <div class="text-center mb-8">
            <h2 class="text-2xl font-extrabold text-gold tracking-wide uppercase mb-1">PIB São Miguel</h2>
            <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Acesso ao Painel de Administração</p>
        </div>

        <% if (erro) { %>
            <div class="mb-6 bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800/50 text-red-600 dark:text-red-400 p-3 rounded-lg flex items-center gap-2 text-sm font-semibold">
                <i data-lucide="alert-circle" class="w-5 h-5 shrink-0"></i>
                <span><%= erro %></span>
            </div>
        <% } %>

        <form action="/login" method="POST" class="space-y-5">
            <div class="space-y-1">
                <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300">Utilizador</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                        <i data-lucide="user" class="w-5 h-5"></i>
                    </div>
                    <input type="text" name="usuario" required autocomplete="off" 
                        class="w-full pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100 rounded-lg focus:ring-2 focus:ring-gold/50 focus:border-gold outline-none transition-all placeholder:text-slate-400">
                </div>
            </div>

            <div class="space-y-1">
                <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300">Palavra-passe</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                        <i data-lucide="lock" class="w-5 h-5"></i>
                    </div>
                    <input type="password" name="senha" required 
                        class="w-full pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100 rounded-lg focus:ring-2 focus:ring-gold/50 focus:border-gold outline-none transition-all placeholder:text-slate-400">
                </div>
            </div>

            <button type="submit" 
                class="w-full flex items-center justify-center gap-2 bg-dark hover:bg-gold text-white hover:text-dark py-3 rounded-lg font-bold uppercase tracking-wider transition-all shadow-lg hover:shadow-gold/25 mt-2">
                <span>Entrar</span>
                <i data-lucide="arrow-right" class="w-5 h-5"></i>
            </button>
        </form>
    </div>

    <script>
        lucide.createIcons();
    </script>
</body>
</html>